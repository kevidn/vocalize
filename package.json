{
  "name": "vocalize-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Vocalize — AI Speech Processing Platform (Monorepo)",
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "lint": "npm --prefix backend run lint && npm --prefix frontend run lint"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "multer": "^2.3.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.2",
    "typescript": "^5.1.3"
  },
  "keywords": [
    "vocalize",
    "speech-to-text",
    "monorepo"
  ],
  "author": "",
  "license": "ISC"
}

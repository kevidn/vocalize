# ─── Vocalize Platform Environment Configuration ───────────────────────────

# Server Environment
NODE_ENV=production
PORT=3001
CORS_ORIGIN=http://localhost:5173
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=uploads

# Option 1: Google Gemini Audio STT (100% Free, Instant setup with Google Account)
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Option 2: Groq Cloud Whisper-Large-v3 (100% Free)
# Get key at: https://console.groq.com/keys
GROQ_API_KEY=

# Option 3: OpenAI Whisper API
OPENAI_API_KEY=
